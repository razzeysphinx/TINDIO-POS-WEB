{
  "name": "tindio-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "check:routes": "node scripts/check-route-files.mjs",
    "check:site-url": "node scripts/check-site-url.mjs",
    "check:release": "pnpm check:encoding && pnpm check:routes && pnpm typecheck && pnpm lint && pnpm build",
    "check:launch": "pnpm check:site-url && pnpm check:release"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "motion": "^13.2.0",
    "next": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.8.3"
  }
}
